# Copy to .env and fill in locally. Do not commit .env.
# Optional overrides
OPENAI_MODEL=gpt-4o

# =====================================================================
# Multi-provider LLM router (core/llm_router.py)
# ---------------------------------------------------------------------
# Every LLM call routes through a task tier; each tier picks a provider.
# Free-first defaults: DeepSeek + Doubao anchor the cheap/extract/premium
# tiers (near-free with their free credits); OpenAI/Anthropic stay as
# opt-in premium upgrades. The router degrades gracefully — if only
# OPENAI_API_KEY is set it behaves exactly like the old code.
#
# Tiers and what runs on them:
#   cheap   -> domain inference, tagging, summaries, background-query, hook regen
#   extract -> grounded fact extraction (low-temp JSON)
#   premium -> final script + research brief (the product)
#
# Default routing (when keys exist): cheap=OpenRouter(free)->Ollama->DeepSeek,
# extract=DeepSeek, premium=DeepSeek (flip premium to gpt-4o/Claude to pay).
#
# RECOMMENDED FREE SETUP (no region locks): DeepSeek + OpenRouter (+ Ollama local).
#
# DeepSeek (OpenAI-compatible, ~10x cheaper than gpt-4o, free promo credits).
# Anchors the extract + premium tiers:
DEEPSEEK_API_KEY=
# OpenRouter (OpenAI-compatible). One key -> many models incl. FREE (`:free`)
# variants. Anchors the cheap tier. Free models are rate-limited but fine here.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL_CHEAP=meta-llama/llama-3.3-70b-instruct:free   # defaults shown
# OPENROUTER_MODEL=deepseek/deepseek-chat   # bare form sets all tiers
# OPENROUTER_SITE_URL=        # optional OpenRouter ranking headers
# OPENROUTER_APP_NAME=Content Machine
#
# Ollama (local, fully free/offline). Available only once OLLAMA_MODEL is set;
# point OLLAMA_BASE_URL at a remote box if not localhost:
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1
#
# Groq (free, fastest) — wired but not a default (console signup is gated for some
# accounts). Use it by setting GROQ_API_KEY (+ optional GROQ_MODEL_CHEAP).
# GROQ_API_KEY=
#
# Doubao / Volcengine Ark — NOT RECOMMENDED: China-region-locked (paid VPN +
# Chinese payment/ID) and saves ~$0 over DeepSeek/OpenRouter. Wired if needed:
# DOUBAO_API_KEY=    (or ARK_API_KEY) + DOUBAO_MODEL=
#
# Per-tier overrides (provider + optional explicit model):
# LLM_CHEAP_PROVIDER=openrouter
# LLM_EXTRACT_PROVIDER=deepseek
# LLM_PREMIUM_PROVIDER=deepseek
# LLM_PREMIUM_MODEL=deepseek-chat
# To upgrade final scripts to premium paid models once you're ready:
# LLM_PREMIUM_PROVIDER=openai      (LLM_PREMIUM_MODEL=gpt-4o)
# LLM_PREMIUM_PROVIDER=anthropic   (LLM_PREMIUM_MODEL=claude-sonnet-4-20250514)
# =====================================================================
YOUTUBE_DAILY_QUOTA=10000
# YouTube speed (optional)
# YOUTUBE_LIGHTWEIGHT=true          # one API call instead of two (faster, less accurate scores)
# YOUTUBE_MAX_RESULTS=5             # fewer results = slightly faster search
# YOUTUBE_CACHE_TTL_SECONDS=21600   # cache YouTube signal 6h (default); general signals use 3h
# VARIANT_REUSE_SIGNALS=            # signals pinned (not re-fetched) during variant scoring.
#                                   # Default: ALL signals — variants are angles on the same
#                                   # topic, and re-fetching cost 150-185s + 429s/spend.
#                                   # Set a csv only to force specific signals to re-fetch.
CONTENT_QUIET_LOGS=true
CONTENT_LOG_LEVEL=WARNING

# PostgreSQL (Phase 2) — also accepts legacy name DATABASE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/content_os
# Schema: alembic upgrade head  (or py -m storage.init_db for dev)
# ALEMBIC_AUTO_UPGRADE=false
# Existing DB before Alembic: alembic stamp 0001

# Topic opportunity scorer (standalone: py -m core.opportunity --topic "..." --channel tapin)
# OPPORTUNITY_ANGLES_LLM=false

# Thumbnail clickability scorer (after render; soft-fail; needs OPENAI_API_KEY for vision)
# THUMBNAIL_MODE=auto
# THUMBNAIL_FLUX_FIRST=true
# BFL_API_KEY=   # Flux AI thumbnail (optional; Pillow always generated too)
# CONTENT_UI_ASCII=true
# CONTENT_UI_MASCOT=luffy
# CONTENT_UI_MASCOT_GAP=8          # min space between CM logo and mascot
# CONTENT_UI_MASCOT_INDENT=4       # pull mascot left from right terminal edge
# CONTENT_UI_COLOR=true

# Intelligence-only mode (skip production tail in main.py; menu option 3 always available)
# CONTENT_MODE=intelligence
# CONTENT_INTELLIGENCE_ONLY=true

# Analyst intelligence (report v2)
# CORROBORATION_BOOST=true
# CORROBORATION_MIN_SCORE=12
# ANALYST_FLAG_THRESHOLD=60
# WIKIPEDIA_PAGEVIEWS_ENABLED=true
# THUMBNAIL_SCORER_ENABLED=false
# OPENAI_VISION_MODEL=gpt-4o

# Repurpose orchestration — enqueue publish jobs per publishers_enabled (YouTube only today)
# REPURPOSE_PUBLISH_ENABLED=true
# AI_CONTENT_DISCLOSURE_LABEL=Created with AI assistance

OPENAI_API_KEY=
ELEVEN_API_KEY=
SPORTSDATA_API_KEY=
YOUTUBE_API_KEY=
NEWS_API_KEY=
STEAM_API_KEY=
RAWG_API_KEY=
SPORTSDB_API_KEY=
ODDS_API_KEY=

# Trends provider chain (no pytrends): SerpApi → Glimpse → Wikipedia pageviews
# TRENDS_PROVIDER_ORDER=serpapi,glimpse,wikipedia
SERPAPI_KEY=
# GLIMPSE_API_KEY=

# Sports stats: BALLDONTLIE API preferred, scrapers fallback
BALLDONTLIE_API_KEY=
# BALLDONTLIE_ENABLED=true
# STATS_PROVIDER_ORDER=balldontlie,api_sports,nflverse,pybaseball,scrapers
API_SPORTS_KEY=

# Finance
FRED_API_KEY=
FINNHUB_API_KEY=
# SEC_EDGAR_USER_AGENT=ContentMachine/1.0 (you@domain.com)

# Pop culture / anime / music
TMDB_API_KEY=
LASTFM_API_KEY=
# MUSICBRAINZ_USER_AGENT=ContentMachine/1.0 (https://yoursite.example)
# ANIME_PROVIDER_ORDER=anilist,jikan

# Gaming+ (Twitch OAuth app — same creds work for IGDB)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Gaming channel: skip unrelated verticals to save latency
# CONTENT_SKIP_SIGNALS=fred,sec_edgar,finnhub,coingecko,anime,tmdb,tvmaze,lastfm,musicbrainz

# Reference stats scrapers (BBR, PFR, ESPN JSON) — fallback when BALLDONTLIE empty
# STATS_SCRAPE_ENABLED=true

# Competitor upload tracking — free YouTube RSS first (saves Data API quota)
# COMPETITOR_SYNC_RSS=true

# Multi-game topics: fanout Steam/RAWG/trends per comma-separated game name (default on)
# TOPIC_FANOUT_ENABLED=true
# Skip irrelevant APIs for gaming: CONTENT_SKIP_SIGNALS=sports,odds,live_scores

# Optional: comma-separated signal names to skip (speed).
# CONTENT_SKIP_SIGNALS=trends,tapology

# --- Fact grounding: regenerate-then-warn (anti-hallucination) ---
# When the post-gen check flags specifics not in VERIFIED FACTS, regenerate once
# to strip them, then warn on whatever remains (never silently rewrites the warning
# away). Default on. Set the minimum flagged count that triggers a regen.
# GROUNDING_REGEN_ENABLED=true
# GROUNDING_REGEN_MIN=1

# --- Original-insight injection (Phase O authenticity) ---
# If a generated script reads as a neutral recap (no opinion/prediction/analysis
# beat), inject one take grounded only in the verified facts. Default on.
# INSIGHT_INJECTION_ENABLED=true

# --- Title-pattern A/B loop (py -m scripts.ops title-patterns --channel tapin) ---
# Attributes realized engagement to the published title's structural pattern
# (colon / number / question / callout / …); patterns above the channel average
# are surfaced as "▲ proven pattern" on matching variants at selection time.
# TITLE_PATTERN_MIN_SAMPLES=3   # min measured videos before a pattern is ranked

# --- Scene-matched B-roll (Phase Q, opt-in) ---
# Cut a different stock clip per script beat instead of looping one. Default OFF
# (render-path feature — verify on a real render). Falls back to the normal
# single/hybrid background on any missing clip, so it never breaks a render.
# SCENE_MATCHED_BROLL=false

# --- Word-level captions (Phase Q) ---
# TTS fetches per-word timestamps from ElevenLabs (free, same call) → captions sync
# to the real spoken audio. CAPTION_STYLE: word = accurate SRT (default, safe),
# karaoke = animated per-word highlight (ASS — verify with a render first),
# plain = the old proportional estimate.
# TTS_WORD_TIMESTAMPS=true
# CAPTION_STYLE=word
# CAPTION_WORDS_PER_LINE=5

# --- Retention-curve modelling (py -m scripts.ops retention --channel tapin) ---
# Syncs the per-position audience-retention curve and, once enough videos exist,
# replaces the static script pacing pivot with the channel's measured drop-off.
# RETENTION_CURVE_SYNC=true     # fetch audienceWatchRatio alongside headline metrics
# RETENTION_MIN_VIDEOS=3        # curves required before the model activates
# RETENTION_DROPOFF_FLOOR=0.5   # retention below this = "dropped off"

# --- Video grading & calibration (Pillar 2: ops grade / calibration / prompt-eval) ---
# Pre-publish report card rolls up hook/authenticity/grounding/topic/thumbnail from
# the persisted quality_json (Pillar 1). The engaged-rate predictor is data-gated:
# below the minimum measured sample it stays silent instead of guessing.
# PREDICTOR_MIN_SAMPLES=15   # measured runs (quality + engagement) before predictions

# --- Fact Engine 2.0 (Pillar 3: verifier, tiers, conflicts) ---
# Claim-level LLM verifier: decomposes the finished script into factual claims and
# checks each against the grounding facts (one extract-tier call — free-first chain,
# fail-open on any LLM error). Default ON; set false to skip the extra call.
# CLAIM_VERIFIER_ENABLED=true
# What unsupported claims do: warn (report only, default) | block (headless skips
# render, interactive asks for an override) — mirrors AUTHENTICITY_GATE.
# GROUNDING_GATE=warn
# Pre-script contradiction check (trade direction / reversed result / champion)
# between operator key facts and the signal+web corpus. Operator wins: conflicting
# source lines are dropped from the corpus before the LLM sees them. Set false to
# keep the lines (conflicts are still reported either way).
# FACT_CONFLICT_FILTER=true
# Vault fact provenance (no new keys needed): notes may declare tier / verified_at /
# expires / source in frontmatter — expired notes stop grounding, fresher + more
# trusted facts rank first. Writers stamp these automatically (operator capture,
# _sources.md); hand-written notes opt in by adding the keys.

# --- Topic Winners / Graveyard (py -m scripts.ops topic-db --channel tapin) ---
# Topics whose published videos averaged below the floor are "graveyard" — added
# to the best-bet avoid-list so discovery stops re-pitching proven flops.
# GRAVEYARD_RATE_FLOOR=0.04   # engaged-rate below this = flop
# GRAVEYARD_AVOID=true        # exclude graveyard topics from best-bet suggestions

# --- Subject anchoring + source sanity ---
# If the script drifts off the operator's pasted key-fact subject (picked "Kape",
# pasted Kape facts, got a different fighter), regenerate once to recenter it.
# KEY_FACT_ANCHOR_ENABLED=true
# Drop self-contradictory future-dated "facts" (a completed event on a date that
# hasn't happened yet) from the corpus before they ground the script.
# FACT_FUTURE_DATE_FILTER=true

# Phase 4 — Stock video backgrounds (fallback: local video/backgrounds/)
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Background: hybrid = local gameplay + stock B-roll (default for TapIn)
# BACKGROUND_MODE=hybrid
# BACKGROUND_MODE=local   # only video/backgrounds/ — no foggy stock fallback
# BACKGROUND_QUERY_LLM=true
# BACKGROUND_LLM_PROVIDER=openai
# BACKGROUND_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Thin-signal script enrichment (RAWG/News/YouTube/RSS + optional LLM extract from sources only)
# RESEARCH_ENRICH_LLM=true
# RESEARCH_ENRICH_PROVIDER=openai
# RESEARCH_ENRICH_PROVIDER=anthropic
# FACT_ENRICH_MIN_LINES=4
# ASSET_PROVIDER_ORDER=local,pexels,pixabay
# Put gameplay clips in video/backgrounds/gaming/ (see video/backgrounds/README.md)

# Tapology scrape for UFC fight cards (off by default — use RSS + news instead)
# TAPOLOGY_SCRAPE_ENABLED=false
# Operator CLI: py -m scripts.ops list | all-setup | validate | test
# FLUX_API_KEY=

# --- Recency: live web search (fixes events past the LLM training cutoff) ---
# Universal signal; never domain-gated. Tavily preferred (LLM-tuned), Brave fallback.
# Load-bearing for current facts — set at least one. Stays inactive (safe) until set.
TAVILY_API_KEY=          # https://tavily.com  (free tier ~1k searches/mo)
BRAVE_SEARCH_API_KEY=    # https://brave.com/search/api  (free tier ~2k/mo)

# --- Obsidian vault → operator key facts (auto-pull + confirm) ---
# Folder of .md notes; relevant bullet lines pre-fill the key-facts prompt.
# MAX_OPERATOR_KEY_FACTS=24          # soft line cap for LLM prompt packing
# OPERATOR_KEY_FACT_CHAR_BUDGET=4500 # total chars sent to script prompt (default)
# Scope a note with frontmatter `channel: tapin` or a channel-named subfolder;
# tag a note `tags: [facts]` to keep it evergreen for that channel.
# OBSIDIAN_VAULT_PATH=
# Pillar 4 (when set): run dossiers land in {channel}/_runs/ after each draft/render;
# weekly reports in {channel}/_reports/; strategy notes feed the CHANNEL PLAYBOOK
# prompt block (style guidance, not facts). ops vault-sync refreshes dossiers.

# --- Signal backend: free vs paid Apify (youtube_competitors + reddit) ---
# apify (default) = current behavior. free = $0 backends, no Apify fallback.
# auto = free first, Apify fallback on empty. See docs/agent_reach_evaluation.md.
# YouTube free = keyless yt-dlp. Reddit free = official OAuth API via a free
# "script app" (create at reddit.com/prefs/apps, ~2 min; 100 req/min free tier).
# SIGNAL_BACKEND=auto
# YT_FREE_TOP_N=5        # videos fully extracted for upload_date/velocity
# YT_FREE_SEARCH_N=15    # flat-search pool ranked by views before extraction
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=windows:content-machine:v0.1 (by /u/yourname)

# --- Cost mode: Free ($0) vs Standard (per-run, chosen at startup) ---
# `py main.py` prompts "Standard vs Free" before a render. Free pins every cost
# center to its $0 backend (local Piper voice, OpenRouter :free / Ollama LLM,
# SIGNAL_BACKEND=free, skip the paid twitter/tiktok/web_search signals) and is
# STRICT: it never falls back to a paid provider — it blocks with setup guidance
# instead. One-time local-backend setup: docs/free_mode.md.
# RUN_COST_MODE=free     # headless default: pick Free without the prompt
# FREE_MODE_STRICT is set automatically by Free mode; it arms the never-pay guards
# at each paid seam (core/tts.py, core/llm_router.py, apis/apify_client.py).
# Free voice needs a local TTS model:
# PIPER_VOICE=C:\path\to\en_US-lessac-medium.onnx   # then TTS_PROVIDER=piper

# --- Signal circuit breaker (auto-skip a signal after quota/auth failure) ---
# SIGNAL_CIRCUIT_BREAKER=true
# SIGNAL_BREAKER_INCLUDE_RATE_LIMIT=false   # promote 429s to a permanent session trip
# SIGNAL_RATE_LIMIT_COOLDOWN_SECONDS=900    # timed cooldown after a 429 (0 = off);
#                                           # "next available" shows in ops reliability
# SIGNAL_BREAKER_PERSIST=true               # remember hard trips across runs
#                                           # (data/quota_state.json; a changed API key
#                                           # clears the record automatically)

# Domain-aware signal gating (skip gaming signals on UFC topics & vice-versa)
# DOMAIN_SIGNAL_GATING=true

# --- Outbound webhook events (n8n / Zapier / any HTTP catcher) ---
# POSTs {"event", "at", "payload"} on run_completed / video_published /
# batch_completed. Unset = disabled. Fire-and-forget, never blocks the pipeline.
# EVENT_WEBHOOK_URL=http://localhost:5678/webhook/content-machine
# EVENT_WEBHOOK_EVENTS=video_published   # csv filter; unset = all events
# EVENT_WEBHOOK_TIMEOUT=5

# --- Cross-run credit/quota state (data/quota_state.json) ---
# A hard Apify 402/limit is remembered across runs so a fresh process skips Apify
# instantly (no preflight, no failing actor call) until the TTL expires.
# QUOTA_STATE_TTL_SECONDS=21600        # how long a persisted exhaustion lasts (6h)
# APIFY_AUTH_FAILURE_TTL_SECONDS=1800  # shorter TTL for 401/403 so a fixed key recovers (30m)
# APIFY_USAGE_CACHE_TTL_SECONDS=1200   # reuse the last Apify usage reading (20m)

# --- Reset-window auto-re-enable (O10) ---
# Known quota reset cadences: a 402/monthly-limit Apify exhaustion persists until
# the actual cycle reset; quota-blocked YouTube uploads retry just after the real
# daily reset (midnight Pacific). Reset times show in `ops reliability`.
# RESET_WINDOW_AUTO_ENABLE=true
# APIFY_RESET_DAY=1                    # day-of-month your Apify usage cycle resets

# --- Semantic trade validation (opt-in — higher false-positive risk) ---
# Warns when a script's "player -> team" trade pairing never co-occurs on a single
# fact line (catches fused trades that token grounding passes). Warns, never blocks.
# SEMANTIC_TRADE_VALIDATION=false

# --- Provider slots (Pillar 6 — baseline, ALL OFF) ------------------------------
# Each is a fail-open seam (docs/providers_runbook.md): unset/uninstalled => the
# current behavior is used. Install heavy backends with: pip install -e ".[providers]".
#
# TTS: local voice instead of ElevenLabs (kills the dominant per-video cost —
# ~96% of a rendered run). Local providers transcode to the same mp3 the render
# reads and meter tts at $0; any failure falls back to ElevenLabs.
# Piper = CPU-only (no torch/GPU) — the Windows-box path. Kokoro needs torch +
# espeak-ng; XTTS needs torch (voice cloning).
# TTS_PROVIDER=elevenlabs            # elevenlabs (default) | piper | kokoro | xtts
# PIPER_VOICE=                       # path to a piper voice .onnx (e.g. en_US-lessac-medium)
# KOKORO_VOICE=af_heart              # kokoro voice id
# KOKORO_LANG=a                      # kokoro lang_code
# XTTS_SPEAKER_WAV=                  # 6s+ clean reference wav for xtts voice clone
# XTTS_LANG=en
#
# Captions: local word-timing when ElevenLabs timestamps aren't available.
# CAPTION_ALIGN_BACKEND=none         # none (default) | whisperx
#
# Music/SFX bed (ducked under VO in the mix — wiring is a follow-up).
# MUSIC_PROVIDER=none                # none (default) | musicgen
# MUSICGEN_MODEL=facebook/musicgen-small
#
# AI video-gen via a self-hosted ComfyUI node graph (fails open to stock B-roll).
# AI_VIDEO_PROVIDER=none             # none (default) | comfyui
# COMFYUI_URL=http://localhost:8188
# COMFYUI_TIMEOUT=8
#
# Dual-format render: the primary 9:16 cut always renders; extras are bonus reach cuts
# (suffixed _16x9 / _1x1), fail-open. Unset = vertical only (byte-identical to before).
# RENDER_FORMATS=vertical,landscape,square
#
# Expert-Panel qualitative grading (personas in prompts/expert_panel/*.md).
# EXPERT_PANEL_ENABLED=false
#
# Multi-source vault ingestion (URL/PDF/YouTube -> provenance-tagged vault note).
# INGEST_ENABLED=false               # gate for *auto* ingestion; explicit calls always run
#
# Avatar (lip-sync) — real-likeness output MUST trip AI disclosure.
# AVATAR_PROVIDER=none               # none (default) | latentsync | hedra | ...
#
# Subject-tracked auto-reframe — backend (YOLO) is AGPL; check license before shipping.
# REFRAME_ENABLED=false
#
# Prompt-eval corpus scoring (else it just lists loaded cases — no LLM spend).
# EVAL_CORPUS_LLM=false

# --- Discovery & fact-intake tuning ---
# Best bets prefer RSS headlines published within this many days, then rotate the
# surfaced set daily (so they don't stay identical for a week).
# BEST_BET_FRESH_DAYS=5
# Drop product/deal/hardware-listing headlines (a gaming feed's "RTX Prebuilt Drops to
# $2,350" is commerce, not a video topic). =false to keep them.
# BEST_BET_FILTER_COMMERCE=true
# Vault scan before generation: only TOPIC-relevant facts are surfaced (distinctive-token
# match) and auto-attached; =false restores the interactive accept/pick prompt.
# VAULT_FACTS_AUTO=true
# Act on the claim verifier: rewrite unsupported claims out (or attribute them) once,
# kept only if the re-verified count improves. One premium LLM call when claims failed.
# CLAIM_REGEN_ENABLED=true
# Opt-in reader proxy for JS-heavy pages (e.g. MSN) that scrape to only a headline.
# Sends the target URL to a third party (r.jina.ai) — off by default (self-hosted-first).
# LINK_READER_PROXY=0
# A dead Apify key (402/403) auto-degrades reddit + youtube_competitors to their free
# backends this session; set REDDIT_CLIENT_ID/SECRET so Reddit survives (free script app),
# or SIGNAL_BACKEND=auto to prefer free first. See docs/agent_reach_evaluation.md.

# --- Terminal UI themes (core/themes.py) ---
# Skins swap the palette, spinner frames + loading copy, section glyphs, meters,
# startup mascot/tagline, and the publish celebration. Per-channel default via
# "ui_theme" in channels.json; this env var overrides it. "plain" = no color/art.
# CONTENT_UI_THEME=            # onepiece | zelda | pokemon | dbz | jjba | plain | default
# CONTENT_UI_COLOR_DEPTH=auto  # auto | 16 | 256 (auto detects Windows Terminal)

# --- Operator spend ceilings (graceful degradation BEFORE the hard walls) ---
# Apify: trip the breaker once monthly spend hits your budget (< Apify's limit).
# APIFY_MONTHLY_BUDGET_USD=5
# LLM: once today's cross-run LLM spend hits this, premium/extract tiers downgrade
# to the free-first cheap chain (only matters if you route a tier to a paid model).
# LLM_DAILY_BUDGET_USD=1

# Active channel profile (see channels.json). Use tapin after seeding analytics.
# CONTENT_CHANNEL_ID=tapin

# Learning: do not log pre-publish composite scores to performance memory (default off)
# RECORD_PROXY_LEARNING=false
# LEARNED_WEIGHT_BLEND=0.65
# USE_LEARNED_POST_SLOTS=auto

# Seed TapIn historical analytics: py -m analytics.seed_tapin --init-db

# Post-upload metrics (stub until Analytics API wired)
# YOUTUBE_ANALYTICS_SYNC=false

# --- YouTube upload + analytics (roadmap 1–3) ---
# YOUTUBE_UPLOAD_ENABLED=true
# YOUTUBE_OAUTH_CLIENT_SECRETS=config/secrets/client_secrets.json
# YOUTUBE_OAUTH_TOKEN_FILE=config/secrets/youtube_token.json
# 1) OAuth (upload + analytics scopes): py -m youtube.oauth_setup --channel tapin
# 2) Verify: py -m youtube.check_setup --channel tapin
# 3) Worker: py -m jobs.worker --loop 30
# YOUTUBE_ANALYTICS_SYNC=true
# Retry metrics: py -m analytics.sync_metrics --channel tapin

# Optimal post times: channels.json post_schedule (CLI option 4 after render)

# Optional signal synthesis metadata (dominant terms, debate density)
# USE_SIGNAL_SYNTHESIS=false

# Stuck job reclaim (minutes a running job may hold the queue)
# JOB_STUCK_MINUTES=45

# Channel intro — prepended to every render (default on if video/intro/channel_intro.mp4 exists)
# CHANNEL_INTRO_ENABLED=true
# CHANNEL_INTRO_PATH=video/intro/channel_intro.mp4
# FFmpeg render hung 40+ min? FFMPEG_SIMPLE_RUN=true  (or kill orphan ffmpeg.exe in Task Manager)

# TikTok & Instagram — deferred (see docs/platform_publish_setup.md when that phase ships)

# Job worker: py -m jobs.worker --loop 30
# Channel and upload are chosen inside the program (interactive prompts).
# CONTENT_CHANNEL_ID only sets the default channel highlight in the menu.
