#!/bin/sh
# Strip AI-attribution trailers agents inject into `git commit`.
# commit-msg still rejects them if anything slips through; this just deletes
# the injected line so a legitimate message can land (AGENTS.md).
msg_file="$1"
tmp="${msg_file}.strip"
grep -viE '^[[:space:]]*(co-authored-by:.*(claude|cursor|copilot|codex|chatgpt|openai|anthropic|\[bot\]|agent@))' "$msg_file" \
  | grep -viE 'generated with \[?claude|generated with \[?cursor|🤖 generated' > "$tmp" || true
mv "$tmp" "$msg_file"
