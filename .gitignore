# Secrets — never commit
.env
.env.*
!.env.example

# Local credentials and keys
*.pem
*.key
credentials.json
secrets.json
config/secrets/*
!config/secrets/README.md

# Legacy root paths (migrated to config/secrets/ or data/)
client_secrets.json
youtube_token.json
youtube_token_*.json
token.json

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/

# Build / runtime artifacts
output/
*.mp3
*.mp4
!video/intro/channel_intro.mp4
*.mov
*.srt

# Local background-clip library — large media (poster frames / screenshots;
# the clips themselves are already covered by *.mp4/*.mov above). Keep the
# tracked structure (README + .gitkeep), ignore the media content.
video/backgrounds/**/*.png
video/backgrounds/**/*.jpg
video/backgrounds/**/*.jpeg
video/backgrounds/**/*.webp

# Local caches and channel data (may contain strategy/performance data)
# Root runtime dir only (anchored) — keeps source dirs like core/data/ tracked.
/data/
assets/cache/
assets/catalog.json

# Local debugging scratch output (e.g. captured CI/test runs)
.tmp_*

# Tooling caches and packaging artifacts
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.egg-info/
build/
dist/
.backup_pre_ruff/

# Pillar 6 — local-only provider assets
# Eval corpus: keep verbatim leaked/adversarial prompts local (README is the marker).
prompts/eval_corpus/*
!prompts/eval_corpus/README.md
!prompts/eval_corpus/invented_release_date.md
# ComfyUI graph exports can be large / machine-specific.
workflows/*.json

# External tool checkouts cloned in for integration (each has its own .git) — local
# only, never embedded into this repo. See docs/providers_runbook.md.
/ComfyUI/
/ai-marketing-skills/
/qiaomu-anything-to-notebooklm/
/system_prompts_leaks/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local vault backups (operator Obsidian notes — never commit)
.vault_backups/

# Local database dumps (operator data — never commit)
.db_backups/

# Local model weights (Piper TTS voices, whisper caches) — large binaries, fetched
# on demand per docs/free_mode.md. Whisper models live in the HF cache outside the repo.
/models/
*.onnx
*.onnx.json
# Piper voice repo cloned into the tree (129 MB of .onnx weights)
/piper-voice-models-main/
